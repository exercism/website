%h1 Representations

- if @representations.empty?
  .c-admin-empty There are no representations yet.
- else
  %table.c-admin-table
    %thead
      %tr
        %th Track
        %th Exercise
        %th Feedback
        %th
    %tbody
      - @representations.each do |representation|
        %tr
          %td= representation.exercise.track.title
          %td= representation.exercise.title
          %td.whitespace-pre-wrap= raw representation.feedback_markdown
          %td= link_to "Edit", edit_admin_exercise_representation_path(representation)
