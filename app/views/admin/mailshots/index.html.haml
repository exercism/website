%h1.text-h1.mb-8 Mailshots
%table.c-admin-table
  %thead
    %tr
      %th Slug
      %th Subject
      %th.text-right Send count
      %th{ colspan: 2 }

  %tbody
  - @mailshots.each do |mailshot|
    %tr
      %td= mailshot.slug
      %td= mailshot.subject
      %td.text-right= @send_counts[mailshot.id]
      %td= link_to "Details", [:admin, mailshot]
      %td= link_to "Edit", edit_admin_mailshot_path(mailshot)
.flex
  = link_to "New mailshot", new_admin_mailshot_path, class: 'btn btn-primary btn-base'
