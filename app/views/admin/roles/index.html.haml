%h1 Roles

%p.mb-8
  Everyone with at least one role. #{link_to "Admin", admin_roles_path(role: :admin)}, #{link_to "maintainer admin", admin_roles_path(role: :maintainer_admin)}
  and #{link_to "maintainer", admin_roles_path(role: :maintainer)} give access to the pages in this section. The other roles are labels.
%p.mb-24
  The website keeps the maintainer and supermentor roles in step with GitHub teams and mentoring stats,
  so a change to either of those will be undone at the next sync.

%section.c-admin-give-role.mb-32
  %h2 Give someone a role
  = form_with url: admin_roles_path, method: :post do |form|
    = hidden_field_tag :filter_role, @role
    .field
      = label_tag :new_role_handle, "Handle"
      = text_field_tag :handle, nil, id: "new_role_handle", placeholder: "Their Exercism handle", required: true, autocomplete: "off", spellcheck: false
    .field
      = label_tag :new_role_role, "Role"
      .c-select
        = select_tag :role, options_for_select(User::Roles::ASSIGNABLE.map { |r| [User::Roles.label(r), r] }), prompt: "Choose a role", id: "new_role_role", required: true
    = form.submit "Add", class: "btn-primary btn-m"

.c-admin-roles-filter.mb-16
  %span.label Show
  = link_to "Everyone", admin_roles_path, class: ("selected" if @role.nil?)
  - User::Roles::ASSIGNABLE.each do |role|
    = link_to User::Roles.label(role), admin_roles_path(role:), class: ("selected" if @role == role)

- if @users.empty?
  .c-admin-empty
    - if @role
      Nobody has the #{User::Roles.label(@role).downcase} role.
    - else
      Nobody has a role yet.
- else
  %table.c-admin-table.c-admin-roles
    %thead
      %tr
        %th Handle
        %th Name
        %th Roles
        %th.add-role-column Add a role
    %tbody
      - @users.each do |user|
        - missing_roles = User::Roles::ASSIGNABLE - user.roles.to_a
        %tr
          %td= link_to user.handle, Exercism::Routes.profile_path(user.handle)
          %td= user.name
          %td
            .roles
              - user.roles.sort.each do |role|
                = button_to admin_role_path(user.handle), method: :delete, params: { role:, filter_role: @role, page: params[:page] },
                  class: "role", title: "Remove the #{User::Roles.label(role)} role from #{user.handle}",
                  form: { data: { turbo_confirm: "Remove the #{User::Roles.label(role)} role from #{user.handle}?" } } do
                  %span= User::Roles.label(role)
                  = graphical_icon "cross"
          %td.add-role-column
            - if missing_roles.any?
              = form_with url: admin_roles_path, method: :post, class: "add-role" do |form|
                = hidden_field_tag :handle, user.handle
                = hidden_field_tag :filter_role, @role
                = hidden_field_tag :page, params[:page]
                .c-select
                  = select_tag :role, options_for_select(missing_roles.map { |r| [User::Roles.label(r), r] }), prompt: "Choose a role", "aria-label": "Role to add to #{user.handle}"
                = form.submit "Add", class: "btn-default btn-xs"

  = paginate @users, params: { role: @role }
