-#
  Only MCP clients see this. Jiki skips it (see skip_authorization).
  The client's host and the redirect host are shown because the client
  chooses its own name, so they're what tell the user who is asking.
- redirect_host = URI(@pre_auth.redirect_uri).host
- loopback = Doorkeeper::OAuth::Helpers::URIChecker.loopback_uri?(URI(@pre_auth.redirect_uri))

%div{ class: "lg-container py-48 max-w-[600px]" }
  %h1.text-h2.mb-16= t('.title')
  %p.text-p-large.mb-16
    = t('.prompt', client_name: tag.strong(@pre_auth.client.application.display_name)).html_safe

  - if @pre_auth.scopes.count.positive?
    %p.mb-8= t('.able_to')
    %ul.list-disc.pl-24.mb-16
      - @pre_auth.scopes.each do |scope|
        %li= t(scope, scope: %i[doorkeeper scopes])

  %p.mb-16= t('.redirect', host: redirect_host)
  - if loopback
    %p.mb-16.text-warning= t('.loopback_warning')

  - fields = { client_id: @pre_auth.client.uid, redirect_uri: @pre_auth.redirect_uri, state: @pre_auth.state, response_type: @pre_auth.response_type, response_mode: @pre_auth.response_mode, scope: @pre_auth.scope, code_challenge: @pre_auth.code_challenge, code_challenge_method: @pre_auth.code_challenge_method }
  .flex.gap-12
    = form_tag oauth_authorization_path, method: :post do
      - fields.each do |name, value|
        = hidden_field_tag name, value, id: nil
      = submit_tag t('doorkeeper.authorizations.buttons.authorize'), class: "btn-m btn-primary"
    = form_tag oauth_authorization_path, method: :delete do
      - fields.each do |name, value|
        = hidden_field_tag name, value, id: nil
      = submit_tag t('doorkeeper.authorizations.buttons.deny'), class: "btn-m btn-secondary"
