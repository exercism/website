- require_stylesheet "about"
- require_stylesheet "track"

#page-favorites
  %nav.c-header-with-bg.mb-32
    .lg-container.flex.mt-24.mb-24
      .content{ class: "max-w-[820px]" }
        = graphical_icon "favorites", css_class: 'w-[32px] h-[32px] mb-12'
        %h1.text-h1.mb-12= t('.heading')
        %p.text-p-large.mb-16
          = t('.intro_html', highlight: content_tag(:strong, t('.intro_highlight'), class: 'font-semibold')).html_safe
        - if current_user.insider?
          %p.text-p-large.mb-16
            = t('.insider_benefit_html', insiders_link: link_to(t('.insiders_link_text'), insiders_path, class: "!font-semibold")).html_safe
        - else
          .border-1.border-purple.bg-lightPurpleDarkened.rounded-8.p-16.mb-16.flex.items-center.gap-16
            = graphical_icon "insiders-lock", css_class: 'w-[48px] h-[48px]'
            .flex.flex-col.gap-4.text-p-large
              %p
                = t('.upgrade_prompt_html', insiders_link: link_to(t('.insiders_link_text'), insiders_path, class: "!font-semibold"), upgrade_link: link_to(t('.upgrade_link_text'), insiders_path, class: "!font-semibold")).html_safe

      = graphical_icon "favorites", css_class: "w-[180px] h-[180px] ml-auto hidden md:block", category: :graphics
      .decorations

  = render ReactComponents::Student::FavoritesList.new(current_user, params)
