- require_stylesheet "insiders"

#page-insiders.pt-40
  .flex.flex-col.items-center.pb-40
    = graphical_icon "insiders", css_class: 'h-[64px] w-[64px] mb-8'
    %h1.text-h1.flex.items-center.mb-8= t('.title')
    %p.text-p-large.mb-32.text-center{ class: 'max-w-[660px]' }= t('.message_html').html_safe

    .w-100{ class: 'max-w-[660px]' }
      = render ReactComponents::Insiders::Join.new(@return_to)
