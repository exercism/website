%h1 Shadow banned users

= form_with(url: moderation_shadow_banned_users_path, method: :post, class: "flex items-end gap-8 mb-24") do |form|
  .flex.flex-col
    = form.label :handle, "User handle", class: 'font-semibold mb-8'
    = form.text_field :handle, required: true
  = form.submit "Shadow ban", class: 'btn-primary btn-m'

- if @users.empty?
  .c-admin-empty Nobody is shadow banned.
- else
  %table.c-admin-table
    %thead
      %tr
        %th Handle
        %th Email
        %th Banned at
        %th Banned by
        %th
    %tbody
      - @users.each do |user|
        %tr
          %td= user.handle
          %td= user.email
          %td= user.shadow_banned_at.strftime("%Y-%m-%d %H:%M")
          %td= user.shadow_banned_by&.handle || "Unknown"
          %td
            = button_to "Remove", moderation_shadow_banned_user_path(user), method: :delete, class: 'btn-default btn-xs'
