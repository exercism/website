.action-box.completed
  .action-box-content
    %h3= t('.title')
    %p.mb-12
      = t('.description_html', count: solution.iterations.size, link: link_to("#{solution.iterations.size} #{t('.iteration_word', count: solution.iterations.size)}", track_exercise_iterations_path(track, exercise))).html_safe
    = render ReactComponents::Student::LatestIterationLink.new(solution)
