#!/usr/bin/env ruby
require 'fileutils'

# Path to the application root.
APP_ROOT = File.expand_path('..', __dir__)

# We want to guard against failures at each stage of this
def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

FileUtils.chdir APP_ROOT do
  # Firstly we're going to run the migrations.
  # We do this via this helper script to sleep and retry on conurrent failures
  system! 'bundle exec bin/rails runner lib/run_migrations_with_concurrent_guard.rb'

  # As EFS files are owned by different users in different places
  # we need to tell libgit to be less stressed about user conflicts.
  # Any instance of "fatal: detected dubious ownership in repository"
  # means that this hasn't worked properly.
  system! "ls -1 -d /mnt/efs/repos/* | xargs -L1 git config --global --add safe.directory"

  # The site serves translations out of a shared EFS checkout of exercism/i18n that
  # a Sidekiq job and a GitHub webhook keep fresh. A container that has just started
  # can therefore be up to ten minutes behind, and on an empty mount it has no
  # checkout at all, so we bring the checkout up to date before serving anything.
  # The clone has not happened yet the first time this runs, so mark the directory
  # as safe here as well as in the glob above.
  # Slightly stale translations are far better than a webserver that will not boot,
  # so the command reports failures to Sentry and returns rather than raising. The
  # outer timeout covers a git process that hangs instead of failing.
  system! "git config --global --add safe.directory /mnt/efs/repos/i18n"
  system("timeout -k 10 180 bundle exec bin/rails runner 'TranslationRepo::SyncOnBoot.()'") ||
    warn("\n== Translations were not synced on boot ==")

  # Warm the local cache of EFS to avoid big read spikes as users start to hit the website.
  system! 'bundle exec bin/rails runner "Track.find_each{|t|begin;t.git.config;rescue;end}"'
  system! 'bundle exec bin/rails runner "Git::WebsiteCopy.new.walkthrough"'
  system! 'bundle exec bin/rails runner "Git::Docs.new.section_config(:using)"'

  # Finally we get the actual server running
  system! "bundle exec bin/rails server -e production -b '0.0.0.0' -p 3000"
end

Track.active.order(:slug).pluck(:slug).map{|s| system("git config --global --add safe.directory /mnt/efs/repos/#{s}}")}


